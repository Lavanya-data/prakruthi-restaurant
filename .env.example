# Prakruthi Restaurant Environment Variables

# Application Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
PORT=5000

# Admin Login Credentials
ADMIN_USER=admin
ADMIN_PASS=admin123

# Database Configuration
# Options: 'sqlite' (default, zero configuration needed) or 'mysql'
DB_TYPE=sqlite

# If DB_TYPE=mysql, configure the connection below:
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=prakruthi
